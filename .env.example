# Copy to .env and fill in. npm start and the CLI read .env if it exists.
# Never commit .env. Keys belong in 1Password (DevKeys) and are loaded from there.

# Postgres 15+ connection string.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/stated

# Encrypts the bot's X tokens at rest. Generate once: openssl rand -base64 32
STATED_TOKEN_KEY=

# Public URL of this server. The X callback is STATED_BASE_URL/callback unless X_REDIRECT_URI is set,
# and it must match a callback registered on the X app exactly.
PORT=8080
STATED_BASE_URL=http://localhost:8080
# X_REDIRECT_URI=http://localhost:8080/callback

# The Stated app on console.x.com (OAuth 2.0). Leave the secret empty for a public (Native App) client.
X_CLIENT_ID=
X_CLIENT_SECRET=

# X user IDs (numbers, comma separated) that can record outcomes and run the desk.
STATED_ADMIN_X_IDS=

# The bot account's numeric X user ID. Without it, only the bot already connected can authorise again,
# and the very first connection binds whichever account approves.
X_BOT_USER_ID=

# Which X post words are stored. 'public-only' (the approved default): only while a public record
# shows the post; a private save keeps the post ID, link, author and the reading of its terms, and its
# owner can ask to see the words, read from X's oEmbed endpoint and kept in memory at most an hour.
# 'all' is an explicit opt-out that stores every saved post's words.
STATED_X_TEXT_POLICY=public-only
# Days between existence checks of privately saved X posts when batch compliance is off
# (public records are then checked daily). 0 = never. With a compliance bearer, private
# IDs go in the daily batch job instead, and public records are looked up about monthly.
STATED_PRIVATE_CHECK_DAYS=7
# App-only bearer for POST /2/compliance/jobs. It has to come from the Stated app.
# The intel public client cannot issue one. Leave unset until the one-time live job
# of about ten IDs in docs/X-ACCESS.md section 9 is approved.
# X_COMPLIANCE_BEARER=
# X's public oEmbed endpoint (no key, no tracking script is loaded).
# X_OEMBED_BASE=https://publish.x.com

# Public replies from the bot. Off until the read-only live test passes (docs/X-ACCESS.md, L1 then L2).
STATED_REPLIES=0
# Links in replies. A post with a URL may bill at $0.20 instead of $0.01.
STATED_REPLY_LINKS=0
# Public replies per tagger per hour; beyond this the acknowledgement goes to the inbox only.
STATED_REPLIES_PER_TAGGER_PER_HOUR=10
# Direct messages. Needs DM permission on the app and dm.read/dm.write on the bot token.
STATED_DM_ENABLED=0

# Mention polling. 'now' ignores mentions made before the first poll; 'all' backfills them (costs reads).
STATED_POLL_MS=60000
STATED_MENTIONS_START=now
# The X worker (mention polling, publishing fills, deletion checks) spends money on X reads.
# It runs only when this is 1. The website, sign-in and testnet Bets work without it.
STATED_WORKER=0

# Set on a public deployment that is not Railway (Railway is detected). The server then refuses to
# start unless STATED_BASE_URL is the https origin, the X callback matches it and the token key is real.
# STATED_HOSTED=1

# X user IDs left out of product metrics (operator test accounts).
STATED_METRICS_EXCLUDE_X_IDS=

# Optional native test-NEAR escrow. Leave empty to disable Bet deposits.
# Setting it enables the separate bounded NEAR refresher, even with STATED_WORKER=0.
STATED_NEAR_CONTRACT=

# A Bet's page can say what its stake would cost from another chain: a dry-run quote from NEAR Intents
# (https://1click.chaindefuser.com). Quotes only; NEAR Intents has no testnet, so nothing is charged or moved.
# STATED_INTENTS_QUOTES=1

# Mainnet: a closed pilot with real NEAR. Read docs/MAINNET.md first. Leave all of this unset for testnet.
# The server refuses to start on mainnet without the acknowledgement, a funded treasury and a database of its own.
# STATED_NEAR_NETWORK=mainnet
# STATED_MAINNET=real-funds
# STATED_PLAY_TREASURY=            # a .near account you created and funded
# STATED_PLAY_TREASURY_KEY=        # its key; keep it in your secret store, never in a file here
# STATED_PILOT_X_IDS=              # X user ids allowed to bet, comma separated; * for anyone
# STATED_INTENTS_DEPOSITS=1        # lets a person pay NEAR into their account from another chain (NEAR Intents)
# STATED_PLAY_START_NEAR=0.05      # what the treasury gives a new account for network fees
